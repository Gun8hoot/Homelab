# --- LANDING PAGE ---
# The IP or the hostname where the webserver live
LANDING_IP="webserver"
# The port to connect to the webserver
LANDING_PORT=3000
# The default language when going on the site for the first time
LANDING_DEFAULT_LANG=fr
# The base domain of our infrastructure
LANDING_BASE_DOMAIN=homelab.lan
# The list of services availables
